# Copy to .env (or .env.local) and fill in. This file is committed: keep it free of real values.
# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty to run on built-in demo data (no database needed)
MONGODB_URI=

# --- Auth.js (generate with: npx auth secret) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Messaging (phase 1) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=

# --- Redis (production rate limiting / caching) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
